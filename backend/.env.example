# Backend settings. Copy to backend/.env (git-ignored) and fill in. Real environment variables win over this file.
# NEVER commit real values.

APP_ENV=development                 # development | testing | production

# MySQL / MariaDB through the PyMySQL driver
DATABASE_URL=mysql+pymysql://campus_app:CHANGE_ME@127.0.0.1:3306/campus_assistant?charset=utf8mb4

# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Browser URL of the Vue app (used in password-reset links)
FRONTEND_URL=http://localhost:5173
# Comma-separated origins for cross-origin calls. Leave empty when using the Vite dev proxy (same origin).
CORS_ORIGINS=

# Refresh-token cookie. COOKIE_SECURE must be true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30

# Brute-force protection
LOGIN_RATE_LIMIT=10/minute
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Uploaded documents are stored here (relative to backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Demo data (python -m app.cli seed-demo): one password for every demo account. Must have 8+ chars, an upper-case letter and a digit.
SEED_DEMO_PASSWORD=

# ---- AI assistant. The key stays on the server; it is never sent to the browser.
# LLM_PROVIDER: anthropic | openai | gemini | mistral | groq | deepseek | openrouter | together | ollama | openai_compatible
# LLM_MODEL is required for every provider except anthropic (default claude-opus-5-5).
# openai_compatible needs LLM_BASE_URL. ollama needs no key.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_EFFORT=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=8000
# Anthropic only: server-side refusal fallback ("default"); leave empty to turn it off (e.g. behind a proxy that rejects it)
LLM_ANTHROPIC_FALLBACKS=default
ASSISTANT_MAX_INPUT_CHARS=2000
ASSISTANT_TURN_SECONDS=90
ASSISTANT_MAX_TOOL_ROUNDS=5
ASSISTANT_HISTORY_MESSAGES=20
ASSISTANT_MAX_MESSAGES_PER_CONVERSATION=200
ASSISTANT_ACTION_TTL_MINUTES=60
ASSISTANT_RETENTION_DAYS=30
ASSISTANT_CHAT_RATE_LIMIT=12/minute;200/day
